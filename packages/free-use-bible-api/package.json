{
    "name": "free-use-bible-api",
    "version": "0.2.0",
    "description": "Access over 1000 Bible translations in over 700 languages for free",
    "keywords": [
        "bible",
        "bible-api",
        "scripture",
        "json",
        "api-client",
        "translations",
        "bsb",
        "typescript"
    ],
    "homepage": "https://bible.helloao.org/docs/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HelloAOLab/bible-api.git",
        "directory": "packages/free-use-bible-api"
    },
    "bugs": {
        "url": "https://github.com/HelloAOLab/bible-api/issues"
    },
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/cjs/index.cjs"
            }
        }
    },
    "scripts": {},
    "author": "Kallyn Gowdy <kal@helloao.org>",
    "license": "MIT",
    "dependencies": {},
    "files": [
        "/README.md",
        "/LICENSE.txt",
        "**/*.js",
        "**/*.cjs",
        "**/*.js.map",
        "**/*.cjs.map",
        "**/*.d.ts"
    ]
}
