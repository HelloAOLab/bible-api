{
    "name": "@free-use-bible-api/react",
    "version": "0.2.0",
    "description": "React components for the Free Use Bible API",
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/cjs/index.cjs"
            }
        }
    },
    "scripts": {},
    "author": "Kallyn Gowdy <kal@helloao.org>",
    "license": "MIT",
    "dependencies": {
        "free-use-bible-api": "workspace:*",
        "react": "^19.2.6"
    },
    "devDependencies": {
        "@types/react": "^19.2.14"
    },
    "files": [
        "/README.md",
        "/LICENSE.txt",
        "**/*.js",
        "**/*.cjs",
        "**/*.js.map",
        "**/*.cjs.map",
        "**/*.d.ts"
    ]
}
