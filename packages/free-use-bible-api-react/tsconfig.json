{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist/types",
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "incremental": true,
        "noUnusedParameters": false,
        "skipLibCheck": true,
        "emitDeclarationOnly": true
    },
    "exclude": [
        "node_modules",
        "lib",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "dist",
        "test"
    ],
    "include": ["./**/*.ts", "./**/*.tsx"],
    "references": [{ "path": "../free-use-bible-api" }]
}
