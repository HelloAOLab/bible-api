{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node"],
        "noEmit": true
    },
    "include": ["src/**/*.ts"],
    // The tests run with the repository's Jest setup, which isn't installed when this package is built on its own.
    "exclude": ["src/**/*.spec.ts"]
}
