{
    "name": "free-use-bible-mcp-server",
    "version": "1.0.0",
    "description": "MCP server exposing the Free Use Bible API (BSB/WEB/WLC/SBL). Runs on Node.js or Cloudflare Workers.",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "tsx src/node.ts",
        "dev": "tsx watch src/node.ts",
        "dev:worker": "wrangler dev",
        "deploy": "wrangler deploy",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@cfworker/json-schema": "^4.1.1",
        "@hono/node-server": "^1.19.9",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "wrangler": "^4.40.0"
    }
}
