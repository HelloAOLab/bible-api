{
    "name": "free-use-bible-api-test",
    "version": "0.2.0",
    "description": "A set of tools for managing HelloAO's Free Bible API",
    "main": "./dist/cjs/index.cjs",
    "module": "./dist/esm/index.js",
    "private": true,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/types/index.d.ts",
                "default": "./dist/cjs/index.cjs"
            }
        }
    },
    "scripts": {},
    "author": "Kallyn Gowdy <kal@helloao.org>",
    "license": "MIT",
    "dependencies": {},
    "devDependencies": {
        "free-use-bible-api": "npm:free-use-bible-api@^0.1.3"
    },
    "files": [
        "/README.md",
        "/LICENSE.txt",
        "/migrations/**/*.sql",
        "**/*.js",
        "**/*.js.map",
        "**/*.cjs",
        "**/*.cjs.map",
        "**/*.d.ts"
    ]
}
